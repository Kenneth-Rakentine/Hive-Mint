# Copy to .env and adjust. .env is gitignored; never commit secrets.

# Database (default: sqlite file at data/hivemint.db)
# HIVEMINT_DB_URL=sqlite:///C:/Hive-Mint/data/hivemint.db

# Daily/monthly limits reset at local midnight in this IANA timezone
HIVEMINT_TIMEZONE=America/New_York

# Cloud spend caps (USD) for Tier 2+ providers
CLOUD_DAILY_BUDGET_USD=1.00
CLOUD_MONTHLY_BUDGET_USD=20.00

# Throughput limits
MAX_IDEAS_PER_DAY=20
MAX_BUILDS_PER_DAY=3
MAX_PUBLICATIONS_PER_DAY=0

# Bounded retries
MAX_JOB_ATTEMPTS=3
MAX_REWORK_CYCLES=3

# Build output (default: products/ and archive/ in the repo)
# HIVEMINT_PRODUCTS_DIR=C:/Hive-Mint/products
# HIVEMINT_ARCHIVE_DIR=C:/Hive-Mint/archive

# Testing recalculates spreadsheet formulas: auto (LibreOffice if installed, else the
# formulas package), libreoffice, or formulas. Set HIVEMINT_SOFFICE if soffice is not on PATH.
HIVEMINT_RECALC_ENGINE=auto
# HIVEMINT_SOFFICE=C:/Program Files/LibreOffice/program/soffice.exe

# Tier 1 local model (Ollama). OLLAMA_MODELS is only read to report the model folder size.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_S=120
# Context window per call (prompt + answer). Ollama's default of 4096 cuts off QA's JSON answer.
OLLAMA_NUM_CTX=8192
# OLLAMA_MODELS=C:/Users/you/.ollama/models

# QA: minimum score to pass, and the most the local model's findings may deduct: text
# clarity pass and chart vision pass. The two caps together must not exceed 100 - QA_PASS_SCORE.
QA_PASS_SCORE=70
QA_MODEL_MAX_DEDUCTION=20
QA_VISION_MAX_DEDUCTION=10

# Visual QA renders each workbook (sheets to PDF, charts to PNG) under products/<id>/v<n>/renders:
# auto (Excel via COM if installed, else LibreOffice), excel, libreoffice, or none (skip).
HIVEMINT_RENDER_ENGINE=auto

# Disk guard: Production jobs pause with DISK_LIMIT below this free space (GB) on the
# drive, or when the Hive-Mint folder grows past this size (GB)
MIN_FREE_DISK_GB=50
MAX_HIVEMINT_STORAGE_GB=20
# HIVEMINT_STORAGE_ROOT=C:/Hive-Mint

# Autopilot (python -m app.cli shift). Headless Claude Code (claude -p) runs on the Max
# subscription: a run is refused if ANTHROPIC_API_KEY is set or claude is not logged in with Max.
# Reported cost is logged only; the hard cap is runs per local day.
MAX_CLAUDE_RUNS_PER_DAY=15
# Distinct products that may get their first build per day (rebuilds count toward MAX_BUILDS_PER_DAY)
MAX_PRODUCTS_BUILT_PER_DAY=2
# Allowed shift window, local time (HIVEMINT_TIMEZONE). A step running when it ends finishes first.
SHIFT_START=13:00
SHIFT_END=22:00
SKIP_ON_BATTERY=true
# CLAUDE_BIN=claude
CLAUDE_TIMEOUT_S=1200

# Finance: weighted opportunity score (each factor 1-5, weights sum to 1; competition and
# support_burden are inverted), scaled to 0-100. Only the top opportunities at or above the
# threshold become products.
OPPORTUNITY_WEIGHTS=demand=0.25,competition=0.15,margin=0.15,ease=0.10,differentiation=0.15,support_burden=0.10,automation_suitability=0.10
OPPORTUNITY_THRESHOLD=65
MAX_OPPORTUNITIES_PER_SHIFT=3
