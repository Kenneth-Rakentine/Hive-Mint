 "files": [
  {
   "name": "Mobile_Detailer_Business_Tracker.xlsx",
   "kind": "xlsx",
   "sheets": [
    {
     "name": "How to Use",
     "kind": "how_to",
     "title": "Mobile Auto Detailer Business Tracker",
     "intro": "One workbook for a mobile detailing business. Enter each job, expense, supply purchase and trip once; the Dashboard, Summary and Customers tabs fill in from those entries.",
     "steps": [
      "Dashboard: type the tax year and your tax set-aside % in the yellow cells (and your odometer readings on January 1 and December 31 if you want your business-use %). Charts and key figures update as you add entries.",
      "Jobs: add one row per job with the date, customer, vehicle, service, payment method, amount and any tip, and mark Paid? Yes or No. This one row counts as income and updates that customer's history.",
      "Customers: add each customer once, before their first job, so their name appears in the Jobs dropdown. Jobs, Total Spent, Unpaid Balance and Last Visit fill in automatically.",
      "Expenses: add business bills and purchases other than detailing supplies, with a category.",
      "Supplies: add chemicals, towels, pads and equipment here (not on Expenses). They count as costs automatically, and Cost per Job shows what each supply costs you per job.",
      "Mileage Log: add one row per business trip. IRS Rate and Deduction fill in from the IRS Rates tab.",
      "Summary: month-by-month income, costs, profit and mileage for the chosen tax year.",
      "Lists: edit the dropdown choices (services, payment methods, expense and supply categories)."
     ],
     "notes": [
      "Each data tab has room for 500 entries and Customers for 200. Only entries dated in the Dashboard's tax year count toward the totals.",
      "Profit After Mileage subtracts the IRS standard mileage deduction from Net Profit. If you use the standard mileage rate, don't also enter fuel or vehicle repairs as expenses for that vehicle.",
      "The tax set-aside is a savings target, not a tax calculation. Many self-employed people put aside 25-30% of profit; ask a tax professional what fits you.",
      "IRS rates included: $0.70/mile from January 1, 2025; $0.725/mile from January 1, 2026; $0.76/mile from July 1, 2026. Check irs.gov for the current rate and add new ones on the IRS Rates tab.",
      "Customer details are personal information. Store this file securely and don't share it.",
      "This product is a record-keeping tool and is not tax advice. Tax rules change and depend on your situation; confirm deductions with a qualified tax professional or irs.gov."
     ]
    },
    {
     "name": "Dashboard",
     "kind": "layout",
     "items": [
      {
       "type": "text",
       "cell": "A1",
       "text": "Detailing Business Dashboard",
       "style": "title"
      },
      {
       "type": "text",
       "cell": "A2",
       "text": "Type in the yellow cells. Everything else updates from your entries."
      },
      {
       "type": "text",
       "cell": "A4",
       "text": "Settings",
       "style": "subtitle"
      },
      {
       "type": "value",
       "cell": "B5",
       "label": "Tax Year",
       "value": 2026,
       "format": "integer",
       "input": true,
       "validation": "number"
      },
      {
       "type": "value",
       "cell": "B6",
       "label": "Tax Set-Aside %",
       "value": 0.25,
       "format": "percent",
       "input": true,
       "validation": "percent"
      },
      {
       "type": "value",
       "cell": "B7",
       "label": "Odometer on January 1",
       "format": "count",
       "input": true,
       "validation": "number"
      },
      {
       "type": "value",
       "cell": "B8",
       "label": "Odometer on December 31",
       "format": "count",
       "input": true,
       "validation": "number"
      },
      {
       "type": "header",
       "cell": "A10",
       "values": [
        "Key Figures",
        ""
       ]
      },
      {
       "type": "value",
       "cell": "B11",
       "label": "Total Income",
       "formula": "=Summary!$B$19",
       "format": "currency"
      },
      {
       "type": "value",
       "cell": "B12",
       "label": "Total Costs",
       "formula": "=Summary!$C$19+Summary!$D$19",
       "format": "currency"
      },
      {
       "type": "value",
       "cell": "B13",
       "label": "Net Profit",
       "formula": "=Summary!$E$19",
       "format": "currency",
       "style": "emphasis"
      },
      {
       "type": "value",
       "cell": "B14",
       "label": "Profit Margin",
       "formula": "=IF(B11=0,0,B13/B11)",
       "format": "percent"
      },
      {
       "type": "value",
       "cell": "B15",
       "label": "Mileage Deduction",
       "formula": "=Summary!$F$19",
       "format": "currency"
      },
      {
       "type": "value",
       "cell": "B16",
       "label": "Profit After Mileage",
       "formula": "=Summary!$G$19",
       "format": "currency",
       "style": "emphasis"
      },
      {
       "type": "value",
       "cell": "B17",
       "label": "Tax Set-Aside",
       "formula": "=ROUND(MAX(0,B16)*B6,2)",
       "format": "currency"
      },
      {
       "type": "value",
       "cell": "B18",
       "label": "Take-Home After Set-Aside",
       "formula": "=B16-B17",
       "format": "currency",
       "style": "emphasis"
      },
      {
       "type": "value",
       "cell": "B19",
       "label": "Jobs Completed",
       "formula": "=COUNTIFS({range:Jobs!Date},\">=\"&DATE({cell:Dashboard!Tax Year},1,1),{range:Jobs!Date},\"<\"&DATE({cell:Dashboard!Tax Year}+1,1,1))",
       "format": "integer"
      },
      {
       "type": "value",
       "cell": "B20",
       "label": "Unpaid Balance",
       "formula": "=SUMIF({range:Jobs!Paid?},\"No\",{range:Jobs!Total})",
       "format": "currency"
      },
      {
       "type": "value",
       "cell": "B21",
       "label": "Business Miles",
       "formula": "=SUMIFS({range:Mileage Log!Business Miles},{range:Mileage Log!Date},\">=\"&DATE({cell:Dashboard!Tax Year},1,1),{range:Mileage Log!Date},\"<\"&DATE({cell:Dashboard!Tax Year}+1,1,1))",
       "format": "number"
      },
      {
       "type": "value",
       "cell": "B22",
       "label": "Total Miles Driven",
       "formula": "=IF(AND(ISNUMBER(B7),ISNUMBER(B8)),B8-B7,\"\")",
       "format": "count"
      },
      {
       "type": "value",
       "cell": "B23",
       "label": "Business Use %",
       "formula": "=IF(ISNUMBER(B22),IF(B22>0,B21/B22,\"\"),\"\")",
       "format": "percent"
      },
      {
       "type": "text",
       "cell": "A25",
       "text": "Unpaid Balance counts every unpaid job, whatever the year. The tax set-aside is a savings target, not a tax calculation. Many self-employed people put aside 25-30% of profit; ask a tax professional what fits you.",
       "style": "wrap"
      },
      {
