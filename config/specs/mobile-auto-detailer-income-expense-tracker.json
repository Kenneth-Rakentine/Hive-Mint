{
  "slug": "mobile-auto-detailer-income-expense-tracker",
  "name": "Mobile Auto Detailer Income & Expense Tracker",
  "spec_version": 3,
  "builder": "mobile_detailer_tracker",
  "zip_name": "Mobile_Detailer_Business_Tracker.zip",
  "resolves": ["merge_workbooks", "dashboard_charts", "profit_after_mileage", "tax_set_aside",
               "chart_titles_clear", "chart_month_labels", "chart_axis_scale", "chart_layout_fits"],
  "changelog": [
    {"spec_version": 1, "summary": "Four separate workbooks, instructions PDF and README."},
    {"spec_version": 2, "summary": "One workbook with tabs (jobs feed income and customer history; supply purchases count as expenses), a Dashboard with three charts, profit after the mileage deduction and a user-set tax set-aside %."},
    {"spec_version": 3, "summary": "Chart fixes: titles above the plot, short horizontal month labels, legend clear of the axis, fixed value-axis scales that read cleanly on an empty workbook, and charts placed side by side without overlap inside a one-page print area that fits a 1920 px screen at 100% zoom."}
  ],
  "parameters": {
    "data_rows": 500,
    "customer_rows": 200,
    "tax_year": 2026,
    "tax_set_aside_pct": 0.25,
    "irs_mileage_rates": [
      {"effective_from": "2025-01-01", "rate": 0.70, "source": "IRS Notice 2025-5"},
      {"effective_from": "2026-01-01", "rate": 0.725, "source": "IRS Notice 2026-10"},
      {"effective_from": "2026-07-01", "rate": 0.76, "source": "IRS Announcement 2026-11"}
    ],
    "expense_categories": [
      "Equipment & Tools", "Fuel", "Vehicle Repairs & Maintenance", "Insurance", "Marketing & Advertising",
      "Phone & Software", "Water & Utilities", "Licenses & Fees", "Training", "Other"
    ],
    "supply_categories": [
      "Chemicals", "Towels & Microfiber", "Pads & Brushes", "Equipment", "Water & Power", "Safety & PPE",
      "Other"
    ],
    "services": [
      "Exterior Wash", "Interior Detail", "Full Detail", "Wax & Sealant", "Paint Correction", "Ceramic Coating",
      "Headlight Restoration", "Engine Bay", "Odor Removal", "Fleet Wash", "Other"
    ],
    "payment_methods": ["Cash", "Card", "Venmo", "Zelle", "Cash App", "PayPal", "Check", "Other"]
  },
  "features": [
    {"id": "single_workbook", "description": "Everything in one workbook with tabs",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Jobs"}},
    {"id": "jobs_log", "description": "Each job is entered once and feeds income, the Dashboard and customer history",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Jobs", "column": "Total"}},
    {"id": "expense_categories", "description": "Expenses by category",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Expenses", "column": "Category"}},
    {"id": "supply_cost_per_job", "description": "Supply purchases with material cost per job",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Supplies", "column": "Cost per Job"}},
    {"id": "mileage_deduction", "description": "Mileage log with the IRS standard mileage deduction",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Mileage Log", "column": "Deduction"}},
    {"id": "editable_irs_rates", "description": "IRS mileage rates the buyer can update",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "IRS Rates", "column": "Rate per Mile"}},
    {"id": "customer_history", "description": "Customer list with visits, spend, unpaid balance and last visit",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Customers", "column": "Unpaid Balance"}},
    {"id": "monthly_summary", "description": "Month-by-month income, costs, profit and mileage",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Summary", "label": "Profit After Mileage"}},
    {"id": "dashboard_charts", "description": "Dashboard with charts that work in Excel and Google Sheets",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Dashboard", "charts_min": 3}},
    {"id": "profit_after_mileage", "description": "Profit after the mileage deduction",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Dashboard", "label": "Profit After Mileage"}},
    {"id": "tax_set_aside", "description": "A user-set tax set-aside % and the amount to put aside",
     "evidence": {"file": "Mobile_Detailer_Business_Tracker.xlsx", "sheet": "Dashboard", "label": "Tax Set-Aside %"}},
    {"id": "instructions", "description": "Step-by-step instructions PDF",
     "evidence": {"file": "Instructions.pdf"}}
  ],
  "spreadsheet_rules": {
    "comment": "Functions available in both Excel (2010+) and Google Sheets. Anything else fails Testing.",
    "allowed_functions": ["AND", "COUNT", "COUNTIF", "COUNTIFS", "DATE", "IF", "ISNUMBER", "MAX", "MIN", "ROUND",
                          "SUM", "SUMIF", "SUMIFS", "SUMPRODUCT", "VLOOKUP"],
    "forbidden_values": ["#REF!", "#DIV/0!", "#NAME?", "#VALUE!", "#N/A", "#NUM!", "#NULL!"]
  },
  "files": [
    {
      "name": "Mobile_Detailer_Business_Tracker.xlsx",
      "kind": "xlsx",
      "sheets": [
        {"name": "How to Use"},
        {"name": "Dashboard",
         "chart_layout": {"print_area": "A1:S35", "max_right_px": 1440,
                          "comment": "Excel at 100% zoom on a 1920 px screen with 125% Windows scaling shows about 1490 logical px of sheet; checked at 96 and 120 DPI"},
         "charts": [
           {"title": "Income vs Costs by Month", "series": 3, "anchor": "D4", "width_px": 500, "height_px": 300,
            "category_axis": "months", "legend": "t",
            "value_axis": {"min": 0, "major_unit": 1000, "num_fmt": "\"$\"#,##0"}},
           {"title": "Profit After Mileage by Month", "series": 1, "anchor": "D20", "width_px": 500,
            "height_px": 300, "category_axis": "months",
            "value_axis": {"allow_negative": true, "major_unit": 1000, "num_fmt": "\"$\"#,##0"},
            "comment": "No fixed minimum: a loss month must show below zero, not be cut off"},
           {"title": "Costs by Category", "series": 1, "anchor": "L4", "width_px": 500, "height_px": 300,
            "horizontal": true,
            "value_axis": {"min": 0, "major_unit": 1000, "num_fmt": "\"$\"#,##0"}}
         ]},
        {"name": "Jobs", "header_row": 1, "freeze_header": true,
         "columns": ["Date", "Customer Name", "Vehicle", "Service", "Payment Method", "Service Amount", "Tip",
                     "Total", "Paid?", "Notes"],
         "validated_columns": ["Date", "Customer Name", "Service", "Payment Method", "Service Amount", "Tip",
                               "Paid?"]},
        {"name": "Expenses", "header_row": 1, "freeze_header": true,
         "columns": ["Date", "Vendor", "Category", "Description", "Payment Method", "Amount", "Notes"],
         "validated_columns": ["Date", "Category", "Payment Method", "Amount"]},
        {"name": "Supplies", "header_row": 1, "freeze_header": true,
         "columns": ["Date", "Supplier", "Product", "Category", "Quantity", "Unit", "Cost per Unit", "Total Cost",
                     "Jobs per Unit", "Cost per Job", "Notes"],
         "validated_columns": ["Date", "Category", "Quantity", "Cost per Unit", "Jobs per Unit"]},
        {"name": "Mileage Log", "header_row": 1, "freeze_header": true,
         "columns": ["Date", "Business Purpose", "Customer / Job", "From", "To", "Business Miles", "IRS Rate",
                     "Deduction", "Notes"],
         "validated_columns": ["Date", "Business Miles"]},
        {"name": "Customers", "header_row": 1, "freeze_header": true,
         "columns": ["Customer Name", "Phone", "Email", "Service Address", "Vehicle(s)", "Preferred Service",
                     "Jobs", "Total Spent", "Unpaid Balance", "Last Visit", "Notes"],
         "validated_columns": ["Preferred Service"]},
        {"name": "Summary"},
        {"name": "IRS Rates", "header_row": 1, "freeze_header": true,
         "columns": ["Effective From", "Rate per Mile", "Source"],
         "validated_columns": ["Effective From", "Rate per Mile"]},
        {"name": "Lists"}
      ],
      "rate_table": {"sheet": "IRS Rates", "date_column": "Effective From", "rate_column": "Rate per Mile",
                     "parameter": "irs_mileage_rates"},
      "scenarios": [
        {"name": "empty template shows zero totals",
         "inputs": [],
         "expect": [
           {"sheet": "Dashboard", "label": "Total Income", "value": 0},
           {"sheet": "Dashboard", "label": "Net Profit", "value": 0},
           {"sheet": "Dashboard", "label": "Profit Margin", "value": 0},
           {"sheet": "Dashboard", "label": "Mileage Deduction", "value": 0},
           {"sheet": "Dashboard", "label": "Tax Set-Aside", "value": 0},
           {"sheet": "Dashboard", "label": "Tax Set-Aside %", "value": 0.25}
         ]},
        {"name": "income $1,000, expenses $250 and supplies $50 give profit $700; other years are excluded",
         "inputs": [
           {"sheet": "Dashboard", "label": "Tax Year", "value": 2026},
           {"sheet": "Jobs", "row": 1, "column": "Date", "value": "2026-03-05"},
           {"sheet": "Jobs", "row": 1, "column": "Service Amount", "value": 900},
           {"sheet": "Jobs", "row": 1, "column": "Tip", "value": 100},
           {"sheet": "Jobs", "row": 2, "column": "Date", "value": "2025-12-31"},
           {"sheet": "Jobs", "row": 2, "column": "Service Amount", "value": 300},
           {"sheet": "Jobs", "row": 3, "column": "Date", "value": "2027-01-01"},
           {"sheet": "Jobs", "row": 3, "column": "Service Amount", "value": 500},
           {"sheet": "Expenses", "row": 1, "column": "Date", "value": "2026-03-09"},
           {"sheet": "Expenses", "row": 1, "column": "Category", "value": "Equipment & Tools"},
           {"sheet": "Expenses", "row": 1, "column": "Amount", "value": 250},
           {"sheet": "Supplies", "row": 1, "column": "Date", "value": "2026-02-01"},
           {"sheet": "Supplies", "row": 1, "column": "Category", "value": "Chemicals"},
           {"sheet": "Supplies", "row": 1, "column": "Quantity", "value": 4},
           {"sheet": "Supplies", "row": 1, "column": "Cost per Unit", "value": 12.5},
           {"sheet": "Supplies", "row": 1, "column": "Jobs per Unit", "value": 10}
         ],
         "expect": [
           {"sheet": "Jobs", "row": 1, "column": "Total", "value": 1000},
           {"sheet": "Supplies", "row": 1, "column": "Total Cost", "value": 50},
           {"sheet": "Supplies", "row": 1, "column": "Cost per Job", "value": 1.25},
           {"sheet": "Dashboard", "label": "Total Income", "value": 1000},
           {"sheet": "Dashboard", "label": "Total Costs", "value": 300},
           {"sheet": "Dashboard", "label": "Net Profit", "value": 700},
           {"sheet": "Dashboard", "label": "Profit Margin", "value": 0.7},
           {"sheet": "Dashboard", "label": "Jobs Completed", "value": 1},
           {"sheet": "Summary", "label": "Feb", "offset": 4, "value": -50},
           {"sheet": "Summary", "label": "Mar", "offset": 4, "value": 750},
           {"sheet": "Summary", "label": "Dec", "offset": 1, "value": 0},
           {"sheet": "Summary", "label": "Costs by Category", "row_offset": 1, "offset": 1, "value": 50},
           {"sheet": "Summary", "label": "Costs by Category", "row_offset": 2, "offset": 1, "value": 250},
           {"sheet": "Summary", "label": "Supplies by Category", "row_offset": 1, "offset": 1, "value": 50}
         ]},
        {"name": "100 miles at each 2026 IRS rate; profit after mileage and a 20% tax set-aside",
         "inputs": [
           {"sheet": "Dashboard", "label": "Tax Year", "value": 2026},
           {"sheet": "Dashboard", "label": "Tax Set-Aside %", "value": 0.2},
           {"sheet": "Dashboard", "label": "Odometer on January 1", "value": 10000},
           {"sheet": "Dashboard", "label": "Odometer on December 31", "value": 30000},
           {"sheet": "Jobs", "row": 1, "column": "Date", "value": "2026-03-05"},
           {"sheet": "Jobs", "row": 1, "column": "Service Amount", "value": 1000},
           {"sheet": "Expenses", "row": 1, "column": "Date", "value": "2026-03-09"},
           {"sheet": "Expenses", "row": 1, "column": "Amount", "value": 250},
           {"sheet": "Supplies", "row": 1, "column": "Date", "value": "2026-02-01"},
           {"sheet": "Supplies", "row": 1, "column": "Quantity", "value": 4},
           {"sheet": "Supplies", "row": 1, "column": "Cost per Unit", "value": 12.5},
           {"sheet": "Mileage Log", "row": 1, "column": "Date", "value": "2026-03-10"},
           {"sheet": "Mileage Log", "row": 1, "column": "Business Miles", "value": 100},
           {"sheet": "Mileage Log", "row": 2, "column": "Date", "value": "2026-08-10"},
           {"sheet": "Mileage Log", "row": 2, "column": "Business Miles", "value": 100},
           {"sheet": "Mileage Log", "row": 3, "column": "Date", "value": "2025-06-01"},
           {"sheet": "Mileage Log", "row": 3, "column": "Business Miles", "value": 10}
         ],
         "expect": [
           {"sheet": "Mileage Log", "row": 1, "column": "IRS Rate", "value": 0.725},
           {"sheet": "Mileage Log", "row": 1, "column": "Deduction", "value": 72.5},
           {"sheet": "Mileage Log", "row": 2, "column": "Deduction", "value": 76},
           {"sheet": "Mileage Log", "row": 3, "column": "Deduction", "value": 7},
           {"sheet": "Dashboard", "label": "Business Miles", "value": 200},
           {"sheet": "Dashboard", "label": "Mileage Deduction", "value": 148.5},
           {"sheet": "Dashboard", "label": "Net Profit", "value": 700},
           {"sheet": "Dashboard", "label": "Profit After Mileage", "value": 551.5},
           {"sheet": "Dashboard", "label": "Tax Set-Aside", "value": 110.3},
           {"sheet": "Dashboard", "label": "Take-Home After Set-Aside", "value": 441.2},
           {"sheet": "Dashboard", "label": "Total Miles Driven", "value": 20000},
           {"sheet": "Dashboard", "label": "Business Use %", "value": 0.01},
           {"sheet": "Summary", "label": "Mar", "offset": 6, "value": 677.5},
           {"sheet": "Summary", "label": "Aug", "offset": 5, "value": 76}
         ]},
        {"name": "a loss sets nothing aside for tax",
         "inputs": [
           {"sheet": "Jobs", "row": 1, "column": "Date", "value": "2026-04-01"},
           {"sheet": "Jobs", "row": 1, "column": "Service Amount", "value": 100},
           {"sheet": "Expenses", "row": 1, "column": "Date", "value": "2026-04-02"},
           {"sheet": "Expenses", "row": 1, "column": "Amount", "value": 500}
         ],
         "expect": [
           {"sheet": "Dashboard", "label": "Profit After Mileage", "value": -400},
           {"sheet": "Dashboard", "label": "Tax Set-Aside", "value": 0},
           {"sheet": "Dashboard", "label": "Take-Home After Set-Aside", "value": -400}
         ]},
        {"name": "an edited IRS rate flows through to the deduction",
         "inputs": [
           {"sheet": "IRS Rates", "row": 3, "column": "Rate per Mile", "value": 0.8},
           {"sheet": "Mileage Log", "row": 1, "column": "Date", "value": "2026-08-10"},
           {"sheet": "Mileage Log", "row": 1, "column": "Business Miles", "value": 100}
         ],
         "expect": [
           {"sheet": "Mileage Log", "row": 1, "column": "Deduction", "value": 80}
         ]},
        {"name": "two jobs for one customer roll up to visits, spend, balance and last visit",
         "inputs": [
           {"sheet": "Customers", "row": 1, "column": "Customer Name", "value": "Jane Doe"},
           {"sheet": "Customers", "row": 2, "column": "Customer Name", "value": "Sam Lee"},
           {"sheet": "Jobs", "row": 1, "column": "Date", "value": "2026-04-01"},
           {"sheet": "Jobs", "row": 1, "column": "Customer Name", "value": "Jane Doe"},
           {"sheet": "Jobs", "row": 1, "column": "Service Amount", "value": 150},
           {"sheet": "Jobs", "row": 1, "column": "Paid?", "value": "Yes"},
           {"sheet": "Jobs", "row": 2, "column": "Date", "value": "2026-05-02"},
           {"sheet": "Jobs", "row": 2, "column": "Customer Name", "value": "Jane Doe"},
           {"sheet": "Jobs", "row": 2, "column": "Service Amount", "value": 80},
           {"sheet": "Jobs", "row": 2, "column": "Tip", "value": 10},
           {"sheet": "Jobs", "row": 2, "column": "Paid?", "value": "No"}
         ],
         "expect": [
           {"sheet": "Customers", "row": 1, "column": "Jobs", "value": 2},
           {"sheet": "Customers", "row": 1, "column": "Total Spent", "value": 240},
           {"sheet": "Customers", "row": 1, "column": "Unpaid Balance", "value": 90},
           {"sheet": "Customers", "row": 1, "column": "Last Visit", "value": "2026-05-02"},
           {"sheet": "Customers", "row": 2, "column": "Jobs", "value": 0},
           {"sheet": "Customers", "row": 2, "column": "Last Visit", "value": ""},
           {"sheet": "Customers", "row": 3, "column": "Jobs", "value": ""},
           {"sheet": "Dashboard", "label": "Unpaid Balance", "value": 90},
           {"sheet": "Dashboard", "label": "Total Income", "value": 240}
         ]}
      ]
    },
    {
      "name": "Instructions.pdf",
      "kind": "pdf",
      "min_pages": 3,
      "max_pages": 10,
      "required_headings": ["What's Included", "Getting Started", "Using Google Sheets", "Dashboard",
                            "Jobs and Customers", "Expenses and Supplies", "Mileage Log", "Monthly Summary",
                            "Tax Time Tips", "Important Notes"]
    },
    {
      "name": "README.txt",
      "kind": "text",
      "required_phrases": ["Mobile_Detailer_Business_Tracker.xlsx", "Instructions.pdf", "Dashboard",
                           "not tax advice"]
    }
  ]
}
